# Express backend
PORT=3001

# PostgreSQL connection through HAProxy
DB_HOST=127.0.0.1
DB_PORT=5000
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=replace_with_your_postgres_password
DB_SSL=false

# PostgreSQL HA infrastructure
POSTGRES_SUPERUSER_PASSWORD=replace_with_your_postgres_password
POSTGRES_STANDBY_PASSWORD=replace_with_your_standby_password

# MinIO
MINIO_ROOT_PASSWORD=replace_with_your_minio_password

# Patroni REST API endpoints
PATRONI_ENDPOINTS=http://127.0.0.1:8008/cluster,http://127.0.0.1:8009/cluster,http://127.0.0.1:8010/cluster
